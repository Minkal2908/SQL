CREATE TABLE employee (
    id INT PRIMARY KEY,
    name VARCHAR(50),
    manager_id INT
);

INSERT INTO employee (id, name, manager_id) VALUES
(101, 'adam', 103),
(102, 'bob', 104),
(103, 'casey', NULL),
(104, 'donald', 103);

SELECT * FROM employee;

-- SELF JOIN 
SELECT *
FROM employee AS a
JOIN employee AS b
ON a.id = b.manager_id;

SELECT a.name AS manager_name, b.name
FROM employee AS a
JOIN employee AS b
ON a.id = b.manager_id;

-- UNION -- can be applied on multiple diff tables also 
SELECT name 
FROM employee
UNION
SELECT name 
FROM employee;

-- UNION ALL -- can be applied on multiple diff tables also
SELECT name 
FROM employee
UNION ALL
SELECT name 
FROM employee;

