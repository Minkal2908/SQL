-- Question:
--   Get names of all students who scored more than class average.   
-- Steps to solve: 2 step process
--   Step 1: Find the avg of class.   
--   Step 2: Find the names of students with marks > avg.  

-- SELECT name, marks
-- FROM student
-- WHERE marks > AVG(marks);
-- ERROR Invalid use of group function

-- Step 1
SELECT AVG(marks) AS AVG
FROM student;

-- STATIC PROCESS which is not good as DB can be changed continously then we have
-- to calculate avg every time individually and then put that avg here to find out
-- ans of given ques 
SELECT name, marks
FROM student
WHERE marks > 87.6667;

-- Step 2 -> DYANMIC PROCESS
SELECT name, marks
FROM student
WHERE marks > (
  SELECT AVG(marks) AS AVG
  FROM student
);

