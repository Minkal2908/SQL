CREATE TABLE student (
  id INT PRIMARY KEY,
  name VARCHAR(50)
);

INSERT INTO student (id, name) VALUES
(101, 'adam'),
(102, 'bob'),
(103, 'casey');

CREATE TABLE course (
  id INT,
  course VARCHAR(50)
);

INSERT INTO course (id, course) VALUES
(102, 'english'),
(105, 'math'),
(103, 'science'),
(107, 'computer science');

-- Table A
SELECT * FROM student;

-- Table B
SELECT * FROM course;

-- Result Grid of INNER JOIN
SELECT *
FROM student AS s
INNER JOIN course AS c
ON s.id = c.id;

-- Result Grid of LEFT JOIN
SELECT * 
FROM student AS s
LEFT JOIN course AS c
ON s.id = c.id;

-- Result Grid of RIGHT JOIN
SELECT * 
FROM student AS s
RIGHT JOIN course AS c
ON s.id = c.id;

-- Result Grid of FULL JOIN
SELECT * 
FROM student AS s
LEFT JOIN course AS c
ON s.id = c.id
UNION
SELECT * 
FROM student AS s
RIGHT JOIN course AS c
ON s.id = c.id;

-- Result Grid of LEFT EXCLUSIVE JOIN
SELECT * 
FROM student AS s
LEFT JOIN course AS c
ON s.id = c.id
WHERE c.id IS NULL;

-- Result Grid of RIGHT EXCLUSIVE JOIN
SELECT * 
FROM student AS s
RIGHT JOIN course AS c
ON s.id = c.id
WHERE s.id IS NULL; 

-- Result Grid of FULL EXCLUSIVE JOIN
SELECT * 
FROM student AS s
LEFT JOIN course AS c
ON s.id = c.id
WHERE c.id IS NULL
UNION
SELECT * 
FROM student AS s
RIGHT JOIN course AS c
ON s.id = c.id
WHERE s.id IS NULL; 



