SELECT DISTINCT m.movie_name, m.genre, u.user_name, r.rating
FROM movies AS m
JOIN ratings AS r
  ON m.movie_id = r.movie_id
JOIN users AS u
  ON r.user_id = u.user_id
JOIN watch_history AS w
  ON u.user_id = w.user_id
  AND m.movie_id = w.movie_id
WHERE m.genre = 'Action' AND 
  u.age > 25 AND
  r.rating >= 4.0 AND
  w.watch_minutes > 60;

