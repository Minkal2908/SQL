SELECT * FROM student;

-- quese: Find the max marks from the students of Delhi
-- step 1
SELECT marks 
FROM student
WHERE city = 'Delhi';

-- step 2
-- SELECT MAX(
--   SELECT marks 
--   FROM student
--   WHERE city = 'Delhi'
-- )
-- FROM student;
-- WRONG b/c aggergate function ke andr pura table nhi koi ek coloumn wagera jaata hai

SELECT MAX(marks)
FROM (
  SELECT marks 
  FROM student
  WHERE city = 'Delhi'
) AS temp; -- FROM wale method se subquery likhne pr alias lagana hin padta hai 

-- OR -> we can give whole table also as small part which have been derived from applying required condition itself
SELECT MAX(marks)
FROM (
  SELECT *
  FROM student
  WHERE city = 'Delhi'
) AS temp;

-- OR same thing written in one line
SELECT MAX(marks) AS highest_marks FROM (SELECT * FROM student WHERE city = 'Delhi') AS temp;


-- an easy way w/o subquery
SELECT MAX(marks) AS highest_marks
FROM student
WHERE city = 'Delhi';


-- Subquery using SELECT -> don't make much sense 
SELECT (SELECT MAX(marks) FROM student) AS A, name
FROM student;

