-- Subquery using FROM
CREATE TABLE student (
  rollno INT PRIMARY KEY,
  name VARCHAR(50),
  marks INT NOT NULL,
  city VARCHAR(50)
);

INSERT INTO student (rollno, name, marks, city) VALUES
