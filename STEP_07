-- 1. Create parent table (dept)
CREATE TABLE dept (
    id INT PRIMARY KEY,
    name VARCHAR(50) NOT NULL
);

-- 2. Insert departments first
INSERT INTO dept (id, name) VALUES
(101, 'Computer Science'),
(102, 'Mathematics'),
(103, 'Physics');

SELECT * FROM dept;

-- 3. Create child table (teacher)
CREATE TABLE teacher (
    id INT PRIMARY KEY,
    name VARCHAR(50),
    dept_id INT,
    FOREIGN KEY (dept_id) REFERENCES dept (id)
      ON DELETE CASCADE
      ON UPDATE CASCADE
);

